{
  "name": "master-oleo-prototipo",
  "private": true,
  "version": "0.1.0",
  "description": "Protótipo isolado da plataforma operacional Master Óleo. Dados fictícios, sem conexão com a base de produção.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "check:isolamento": "node scripts/check-isolamento.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "puppeteer-core": "23.11.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
