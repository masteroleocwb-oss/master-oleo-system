rules_version = '2';
// Master Óleo — fotos: só quem está logado envia ou lê pelo sistema.
// (Os links de foto já salvos nas OS continuam abrindo normalmente.)
// Só entram imagens de até 25 MB, cada arquivo uma vez: ninguém substitui nem apaga foto já enviada.
// Sem consulta ao banco (não precisa da permissão extra "regras entre serviços" no Google Cloud).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if resource == null && request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/octet-stream');
      allow update, delete: if false;
    }
  }
}
